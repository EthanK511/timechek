# Slack Incoming Webhook used by result/reminder endpoints (existing huddle feature)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/team/webhook

# Slack App bot OAuth token (xoxb-...) — required for /find-time slash commands
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App signing secret — used to verify that requests come from Slack
SLACK_SIGNING_SECRET=your-signing-secret-here

# Optional server port (defaults to 3000)
PORT=3000
